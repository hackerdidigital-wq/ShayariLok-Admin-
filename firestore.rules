rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isVerifiedAdminEmail() {
      return isVerified() && request.auth.token.email == 'bamniyad749@gmail.com';
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || request.auth.token.email == 'bamniyad749@gmail.com'
      );
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRepoConnection(data) {
      return data.keys().hasAll(['ownerId', 'githubOwner', 'githubRepo', 'githubBranch', 'githubPath', 'lastSha', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'githubOwner', 'githubRepo', 'githubBranch', 'githubPath', 'lastSha', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.githubOwner is string && data.githubOwner.size() >= 1 && data.githubOwner.size() <= 100
        && data.githubRepo is string && data.githubRepo.size() >= 1 && data.githubRepo.size() <= 120
        && data.githubBranch is string && data.githubBranch.size() >= 1 && data.githubBranch.size() <= 100
        && data.githubPath is string && data.githubPath.size() >= 1 && data.githubPath.size() <= 256
        && data.lastSha is string && data.lastSha.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidConfigDraft(data) {
      return data.keys().hasAll([
          'ownerId', 'app_name', 'latest_version_code', 'force_update_url',
          'maintenance_mode', 'maintenance_message', 'privacy_policy_url',
          'social_link', 'ads_enabled', 'banner_ad_id', 'interstitial_ad_id',
          'announcement_title', 'announcement_message', 'categories',
          'notifications', 'shayari_list', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'app_name', 'latest_version_code', 'force_update_url',
          'maintenance_mode', 'maintenance_message', 'privacy_policy_url',
          'social_link', 'ads_enabled', 'banner_ad_id', 'interstitial_ad_id',
          'announcement_title', 'announcement_message', 'categories',
          'notifications', 'shayari_list', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.app_name is string && data.app_name.size() >= 1 && data.app_name.size() <= 80
        && data.latest_version_code is int && data.latest_version_code >= 1 && data.latest_version_code <= 9999999
        && data.force_update_url is string && data.force_update_url.size() <= 500
        && data.maintenance_mode is bool
        && data.maintenance_message is string && data.maintenance_message.size() <= 1000
        && data.privacy_policy_url is string && data.privacy_policy_url.size() <= 500
        && data.social_link is string && data.social_link.size() <= 500
        && data.ads_enabled is bool
        && data.banner_ad_id is string && data.banner_ad_id.size() <= 120
        && data.interstitial_ad_id is string && data.interstitial_ad_id.size() <= 120
        && data.announcement_title is string && data.announcement_title.size() <= 200
        && data.announcement_message is string && data.announcement_message.size() <= 1000
        && data.categories is list && data.categories.size() >= 1 && data.categories.size() <= 50
        && data.categories[0] is string && data.categories[0] == 'All'
        && data.notifications is list && data.notifications.size() <= 100
        && (data.notifications.size() == 0 || data.notifications[0] is map)
        && data.shayari_list is list && data.shayari_list.size() <= 500
        && (data.shayari_list.size() == 0 || data.shayari_list[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidPublishLog(data) {
      return data.keys().hasAll([
          'ownerId', 'commitSha', 'branch', 'filePath', 'versionCode',
          'shayariCount', 'message', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'commitSha', 'branch', 'filePath', 'versionCode',
          'shayariCount', 'message', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.commitSha is string && data.commitSha.size() >= 1 && data.commitSha.size() <= 128
        && data.branch is string && data.branch.size() >= 1 && data.branch.size() <= 100
        && data.filePath is string && data.filePath.size() >= 1 && data.filePath.size() <= 256
        && data.versionCode is int && data.versionCode >= 1 && data.versionCode <= 9999999
        && data.shayariCount is int && data.shayariCount >= 0 && data.shayariCount <= 10000
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 300
        && data.createdAt is timestamp;
    }

    function isValidProxyProfile(data) {
      return data.keys().hasAll([
          'ownerId', 'mode', 'primaryProxyUrl', 'rawMirrorUrl', 'fallbackNodes',
          'timeoutMs', 'maxRetries', 'autoFallbackToDirect', 'forwardPatThroughProxy',
          'customHeaderName', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'mode', 'primaryProxyUrl', 'rawMirrorUrl', 'fallbackNodes',
          'timeoutMs', 'maxRetries', 'autoFallbackToDirect', 'forwardPatThroughProxy',
          'customHeaderName', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.mode is string && data.mode in ['direct', 'cloudflare_worker', 'custom_prefix', 'mirror_read']
        && data.primaryProxyUrl is string && data.primaryProxyUrl.size() <= 500
        && data.rawMirrorUrl is string && data.rawMirrorUrl.size() <= 500
        && data.fallbackNodes is list && data.fallbackNodes.size() <= 10
        && (data.fallbackNodes.size() == 0 || data.fallbackNodes[0] is map)
        && data.timeoutMs is int && data.timeoutMs >= 1000 && data.timeoutMs <= 60000
        && data.maxRetries is int && data.maxRetries >= 0 && data.maxRetries <= 5
        && data.autoFallbackToDirect is bool
        && data.forwardPatThroughProxy is bool
        && data.customHeaderName is string && data.customHeaderName.size() <= 80
        && data.updatedAt is timestamp;
    }

    function isValidPublicSite(data) {
      return data.keys().hasAll([
          'ownerId', 'organizationName', 'supportEmail', 'app_name',
          'latest_version_code', 'force_update_url', 'maintenance_mode',
          'maintenance_message', 'privacy_policy_url', 'social_link',
          'ads_enabled', 'announcement_title', 'announcement_message',
          'categories', 'notifications', 'shayari_list',
          'heroHeadline', 'heroSubheadline', 'websiteControls',
          'suvichar_list', 'photo_shayari_list', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'organizationName', 'supportEmail', 'app_name',
          'latest_version_code', 'force_update_url', 'maintenance_mode',
          'maintenance_message', 'privacy_policy_url', 'social_link',
          'ads_enabled', 'announcement_title', 'announcement_message',
          'categories', 'notifications', 'shayari_list',
          'heroHeadline', 'heroSubheadline', 'websiteControls',
          'suvichar_list', 'photo_shayari_list', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.organizationName is string && data.organizationName.size() >= 1 && data.organizationName.size() <= 120
        && data.supportEmail is string && data.supportEmail.size() <= 254
        && data.app_name is string && data.app_name.size() >= 1 && data.app_name.size() <= 80
        && data.latest_version_code is int && data.latest_version_code >= 1 && data.latest_version_code <= 9999999
        && data.force_update_url is string && data.force_update_url.size() <= 500
        && data.maintenance_mode is bool
        && data.maintenance_message is string && data.maintenance_message.size() <= 1000
        && data.privacy_policy_url is string && data.privacy_policy_url.size() <= 500
        && data.social_link is string && data.social_link.size() <= 500
        && data.ads_enabled is bool
        && data.announcement_title is string && data.announcement_title.size() <= 200
        && data.announcement_message is string && data.announcement_message.size() <= 1000
        && data.categories is list && data.categories.size() >= 1 && data.categories.size() <= 50
        && data.categories[0] is string && data.categories[0] == 'All'
        && data.notifications is list && data.notifications.size() <= 100
        && (data.notifications.size() == 0 || data.notifications[0] is map)
        && data.shayari_list is list && data.shayari_list.size() <= 500
        && (data.shayari_list.size() == 0 || data.shayari_list[0] is map)
        && data.heroHeadline is string && data.heroHeadline.size() <= 240
        && data.heroSubheadline is string && data.heroSubheadline.size() <= 500
        && data.websiteControls is map
        && data.websiteControls.keys().hasAll([
          'showNotificationBell', 'showAnnouncementBanner',
          'showSuvicharSection', 'showPhotoShayariSection', 'showMaintenanceNotice'
        ])
        && data.websiteControls.keys().hasOnly([
          'showNotificationBell', 'showAnnouncementBanner',
          'showSuvicharSection', 'showPhotoShayariSection', 'showMaintenanceNotice'
        ])
        && data.websiteControls.showNotificationBell is bool
        && data.websiteControls.showAnnouncementBanner is bool
        && data.websiteControls.showSuvicharSection is bool
        && data.websiteControls.showPhotoShayariSection is bool
        && data.websiteControls.showMaintenanceNotice is bool
        && data.suvichar_list is list && data.suvichar_list.size() <= 100
        && (data.suvichar_list.size() == 0 || data.suvichar_list[0] is map)
        && data.photo_shayari_list is list && data.photo_shayari_list.size() <= 60
        && (data.photo_shayari_list.size() == 0 || data.photo_shayari_list[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidAppUser(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'username', 'city', 'address', 'bio',
          'isOnline', 'isBlocked', 'blockReason', 'followersCount',
          'followingCount', 'likesReceivedCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'username', 'city', 'address', 'bio',
          'isOnline', 'isBlocked', 'blockReason', 'followersCount',
          'followingCount', 'likesReceivedCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 40 && data.username.matches('^[a-zA-Z0-9_.]+$')
        && data.city is string && data.city.size() <= 80
        && data.address is string && data.address.size() <= 200
        && data.bio is string && data.bio.size() <= 300
        && data.isOnline is bool
        && data.isBlocked is bool
        && data.blockReason is string && data.blockReason.size() <= 240
        && data.followersCount is int && data.followersCount >= 0 && data.followersCount <= 10000000
        && data.followingCount is int && data.followingCount >= 0 && data.followingCount <= 10000000
        && data.likesReceivedCount is int && data.likesReceivedCount >= 0 && data.likesReceivedCount <= 100000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSocialEdge(data) {
      return data.keys().hasAll(['actorId', 'targetId', 'actorName', 'targetName', 'type', 'createdAt'])
        && data.keys().hasOnly(['actorId', 'targetId', 'actorName', 'targetName', 'type', 'createdAt'])
        && isValidId(data.actorId)
        && isValidId(data.targetId)
        && data.actorId != data.targetId
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 100
        && data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 100
        && data.type is string && data.type in ['follow', 'like']
        && data.createdAt is timestamp;
    }

    function isValidChatRoom(data) {
      return data.keys().hasAll([
          'participantIds', 'participantNames', 'lastMessage', 'lastSenderId',
          'messageCount', 'flaggedSpam', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'participantIds', 'participantNames', 'lastMessage', 'lastSenderId',
          'messageCount', 'flaggedSpam', 'updatedAt'
        ])
        && data.participantIds is list && data.participantIds.size() == 2
        && isValidId(data.participantIds[0]) && isValidId(data.participantIds[1])
        && data.participantIds[0] != data.participantIds[1]
        && data.participantNames is list && data.participantNames.size() == 2
        && data.participantNames[0] is string && data.participantNames[0].size() >= 1 && data.participantNames[0].size() <= 100
        && data.participantNames[1] is string && data.participantNames[1].size() >= 1 && data.participantNames[1].size() <= 100
        && data.lastMessage is string && data.lastMessage.size() <= 1000
        && isValidId(data.lastSenderId)
        && data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 1000000
        && data.flaggedSpam is bool
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll([
          'roomId', 'senderId', 'senderName', 'receiverId', 'text', 'isFlagged', 'createdAt'
        ])
        && data.keys().hasOnly([
          'roomId', 'senderId', 'senderName', 'receiverId', 'text', 'isFlagged', 'createdAt'
        ])
        && isValidId(data.roomId)
        && isValidId(data.senderId)
        && isValidId(data.receiverId)
        && data.senderId != data.receiverId
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000
        && data.isFlagged is bool
        && data.createdAt is timestamp;
    }

    match /publicSites/{siteId} {
      allow get: if isValidId(siteId);
      allow list: if false;
      allow create: if isValidId(siteId)
        && isOwner(siteId)
        && isValidPublicSite(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(siteId)
        && isOwner(siteId)
        && isValidPublicSite(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(siteId) && isOwner(siteId);
    }

    match /appUsers/{appUserId} {
      allow get: if isValidId(appUserId) && (isAdmin() || (isVerified() && request.auth.uid == appUserId));
      allow list: if isVerifiedAdminEmail() || (isVerified() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(appUserId)
        && isValidAppUser(incoming())
        && incoming().uid == appUserId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isVerified()
            && request.auth.uid == appUserId
            && incoming().isBlocked == false
            && incoming().blockReason == ''
            && incoming().followersCount == 0
            && incoming().followingCount == 0
            && incoming().likesReceivedCount == 0
          )
        );
      allow update: if isValidId(appUserId)
        && isValidAppUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isVerified()
            && request.auth.uid == appUserId
            && incoming().isBlocked == existing().isBlocked
            && incoming().blockReason == existing().blockReason
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'username', 'city', 'address', 'bio', 'isOnline', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(appUserId) && isAdmin();
    }

    match /socialEdges/{edgeId} {
      allow get: if isValidId(edgeId) && (
        isAdmin()
        || (isVerified() && (existing().actorId == request.auth.uid || existing().targetId == request.auth.uid))
      );
      allow list: if isVerifiedAdminEmail()
        || (isVerified() && (resource.data.actorId == request.auth.uid || resource.data.targetId == request.auth.uid));
      allow create: if isValidId(edgeId)
        && isValidSocialEdge(incoming())
        && incoming().createdAt == request.time
        && (
          isAdmin()
          || (
            isVerified()
            && incoming().actorId == request.auth.uid
            && exists(/databases/$(database)/documents/appUsers/$(incoming().actorId))
            && exists(/databases/$(database)/documents/appUsers/$(incoming().targetId))
          )
        );
      allow update: if false;
      allow delete: if isValidId(edgeId) && (
        isAdmin()
        || (isVerified() && existing().actorId == request.auth.uid)
      );
    }

    match /chatRooms/{roomId} {
      allow get: if isValidId(roomId) && (
        isAdmin()
        || (isVerified() && request.auth.uid in existing().participantIds)
      );
      allow list: if isVerifiedAdminEmail()
        || (isVerified() && request.auth.uid in resource.data.participantIds);
      allow create: if isValidId(roomId)
        && isValidChatRoom(incoming())
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isVerified()
            && request.auth.uid in incoming().participantIds
            && incoming().lastSenderId == request.auth.uid
            && incoming().flaggedSpam == false
          )
        );
      allow update: if isValidId(roomId)
        && isValidChatRoom(incoming())
        && incoming().participantIds == existing().participantIds
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isVerified()
            && request.auth.uid in existing().participantIds
            && incoming().lastSenderId == request.auth.uid
            && incoming().flaggedSpam == existing().flaggedSpam
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessage', 'lastSenderId', 'messageCount', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(roomId) && isAdmin();

      match /messages/{messageId} {
        allow get: if isValidId(roomId) && isValidId(messageId) && (
          isAdmin()
          || (isVerified() && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participantIds)
        );
        allow list: if isVerifiedAdminEmail()
          || (isVerified() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid));
        allow create: if isValidId(roomId)
          && isValidId(messageId)
          && isValidChatMessage(incoming())
          && incoming().roomId == roomId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/chatRooms/$(roomId))
          && (
            isAdmin()
            || (
              isVerified()
              && incoming().senderId == request.auth.uid
              && incoming().isFlagged == false
              && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participantIds
              && get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.isBlocked == false
            )
          );
        allow update: if isValidId(roomId)
          && isValidId(messageId)
          && isValidChatMessage(incoming())
          && incoming().roomId == existing().roomId
          && incoming().senderId == existing().senderId
          && incoming().receiverId == existing().receiverId
          && incoming().createdAt == existing().createdAt
          && isAdmin()
          && incoming().diff(existing()).affectedKeys().hasOnly(['isFlagged', 'text']);
        allow delete: if isValidId(roomId) && isValidId(messageId) && isAdmin();
      }
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidAdminUser(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidAdminUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if false;

      match /settings/{settingId} {
        allow get: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(settingId)
          && isOwner(userId)
          && isValidRepoConnection(incoming())
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(settingId)
          && isOwner(userId)
          && isValidRepoConnection(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'githubOwner', 'githubRepo', 'githubBranch', 'githubPath', 'lastSha', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
      }

      match /drafts/{draftId} {
        allow get: if isValidId(userId) && isValidId(draftId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(draftId)
          && isOwner(userId)
          && isValidConfigDraft(incoming())
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(draftId)
          && isOwner(userId)
          && isValidConfigDraft(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'app_name', 'latest_version_code', 'force_update_url',
            'maintenance_mode', 'maintenance_message', 'privacy_policy_url',
            'social_link', 'ads_enabled', 'banner_ad_id', 'interstitial_ad_id',
            'announcement_title', 'announcement_message', 'categories',
            'notifications', 'shayari_list', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(draftId) && isOwner(userId);
      }

      match /publishLogs/{logId} {
        allow get: if isValidId(userId) && isValidId(logId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(logId)
          && isOwner(userId)
          && isValidPublishLog(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update, delete: if false;
      }

      match /proxyProfiles/{profileId} {
        allow get: if isValidId(userId) && isValidId(profileId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(profileId)
          && isOwner(userId)
          && isValidProxyProfile(incoming())
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(profileId)
          && isOwner(userId)
          && isValidProxyProfile(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'mode', 'primaryProxyUrl', 'rawMirrorUrl', 'fallbackNodes',
            'timeoutMs', 'maxRetries', 'autoFallbackToDirect',
            'forwardPatThroughProxy', 'customHeaderName', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(profileId) && isOwner(userId);
      }
    }
  }
}
