{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authenticated admin user profile stored privately per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified Google account email."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "AdminAllowlist": {
      "title": "AdminAllowlist",
      "description": "Authorized co-admin account allowlist managed exclusively by primary verified admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authorized admin Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified Google email of authorized admin."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "editor"],
          "description": "Assigned administrative role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Authorization grant server timestamp."
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "RepoConnection": {
      "title": "RepoConnection",
      "description": "GitHub repository metadata (without sensitive PAT) synced for the signed-in admin.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "githubOwner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "GitHub username or organization."
        },
        "githubRepo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "GitHub repository name."
        },
        "githubBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Target branch name (default main)."
        },
        "githubPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Path to config.json in repository."
        },
        "lastSha": {
          "type": "string",
          "maxLength": 128,
          "description": "Last known GitHub blob SHA."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "ownerId",
        "githubOwner",
        "githubRepo",
        "githubBranch",
        "githubPath",
        "lastSha",
        "updatedAt"
      ]
    },
    "ConfigDraft": {
      "title": "ConfigDraft",
      "description": "Cloud-synced draft snapshot of Shayari Lok config.json.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "app_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Android app display name."
        },
        "latest_version_code": {
          "type": "integer",
          "description": "Latest Android version code."
        },
        "force_update_url": {
          "type": "string",
          "maxLength": 500,
          "description": "Play Store or APK update URL."
        },
        "maintenance_mode": {
          "type": "boolean",
          "description": "Maintenance switch."
        },
        "maintenance_message": {
          "type": "string",
          "maxLength": 1000,
          "description": "Message displayed during maintenance."
        },
        "privacy_policy_url": {
          "type": "string",
          "maxLength": 500,
          "description": "Privacy policy URL."
        },
        "social_link": {
          "type": "string",
          "maxLength": 500,
          "description": "Telegram or Instagram URL."
        },
        "ads_enabled": {
          "type": "boolean",
          "description": "AdMob master toggle."
        },
        "banner_ad_id": {
          "type": "string",
          "maxLength": 120,
          "description": "AdMob banner unit ID."
        },
        "interstitial_ad_id": {
          "type": "string",
          "maxLength": 120,
          "description": "AdMob interstitial unit ID."
        },
        "announcement_title": {
          "type": "string",
          "maxLength": 200,
          "description": "In-app announcement title."
        },
        "announcement_message": {
          "type": "string",
          "maxLength": 1000,
          "description": "In-app announcement message."
        },
        "categories": {
          "type": "array",
          "description": "Bounded list of Shayari categories starting with All."
        },
        "notifications": {
          "type": "array",
          "description": "Bounded list of bell notification items."
        },
        "shayari_list": {
          "type": "array",
          "description": "Bounded list of Shayari items."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "ownerId",
        "app_name",
        "latest_version_code",
        "force_update_url",
        "maintenance_mode",
        "maintenance_message",
        "privacy_policy_url",
        "social_link",
        "ads_enabled",
        "banner_ad_id",
        "interstitial_ad_id",
        "announcement_title",
        "announcement_message",
        "categories",
        "notifications",
        "shayari_list",
        "updatedAt"
      ]
    },
    "PublishLog": {
      "title": "PublishLog",
      "description": "Immutable history entry recording a GitHub config.json commit.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "commitSha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Resulting GitHub file or commit SHA."
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Branch published to."
        },
        "filePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "File path published."
        },
        "versionCode": {
          "type": "integer",
          "description": "Version code at publish time."
        },
        "shayariCount": {
          "type": "integer",
          "description": "Total shayari count at publish time."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Commit message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Publish server timestamp."
        }
      },
      "required": [
        "ownerId",
        "commitSha",
        "branch",
        "filePath",
        "versionCode",
        "shayariCount",
        "message",
        "createdAt"
      ]
    },
    "ProxyProfile": {
      "title": "ProxyProfile",
      "description": "Non-secret GitHub API proxy and CDN mirror routing preferences for the signed-in admin.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "mode": {
          "type": "string",
          "enum": ["direct", "cloudflare_worker", "custom_prefix", "mirror_read"],
          "description": "Active routing mode for GitHub and raw config reads."
        },
        "primaryProxyUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Primary proxy worker or prefix URL."
        },
        "rawMirrorUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "CDN or raw mirror URL template for GET config reads."
        },
        "fallbackNodes": {
          "type": "array",
          "description": "Bounded list of up to 10 fallback proxy node configs."
        },
        "timeoutMs": {
          "type": "integer",
          "description": "Request timeout in milliseconds (1000-60000)."
        },
        "maxRetries": {
          "type": "integer",
          "description": "Automatic retry attempts per route (0-5)."
        },
        "autoFallbackToDirect": {
          "type": "boolean",
          "description": "Whether to fall back to direct api.github.com if proxy nodes fail."
        },
        "forwardPatThroughProxy": {
          "type": "boolean",
          "description": "Whether to forward GitHub PAT through trusted worker proxies."
        },
        "customHeaderName": {
          "type": "string",
          "maxLength": 80,
          "description": "Optional custom proxy header name (value stays local-only)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "ownerId",
        "mode",
        "primaryProxyUrl",
        "rawMirrorUrl",
        "fallbackNodes",
        "timeoutMs",
        "maxRetries",
        "autoFallbackToDirect",
        "forwardPatThroughProxy",
        "customHeaderName",
        "updatedAt"
      ]
    },
    "PublicSite": {
      "title": "PublicSite",
      "description": "Publicly readable real-time website mirror combining Shayari Lok config, Suvichar, Photo Shayari cards, and admin notification visibility controls.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "organizationName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Publisher organization display name."
        },
        "supportEmail": {
          "type": "string",
          "maxLength": 254,
          "description": "Public support email for privacy inquiries."
        },
        "app_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Public app brand name."
        },
        "latest_version_code": {
          "type": "integer",
          "description": "Latest Android version code."
        },
        "force_update_url": {
          "type": "string",
          "maxLength": 500,
          "description": "App download URL."
        },
        "maintenance_mode": {
          "type": "boolean",
          "description": "Maintenance switch."
        },
        "maintenance_message": {
          "type": "string",
          "maxLength": 1000,
          "description": "Maintenance message."
        },
        "privacy_policy_url": {
          "type": "string",
          "maxLength": 500,
          "description": "Canonical privacy policy URL."
        },
        "social_link": {
          "type": "string",
          "maxLength": 500,
          "description": "Community channel link."
        },
        "ads_enabled": {
          "type": "boolean",
          "description": "Public indicator for AdMob policy disclosure."
        },
        "announcement_title": {
          "type": "string",
          "maxLength": 200,
          "description": "Announcement headline."
        },
        "announcement_message": {
          "type": "string",
          "maxLength": 1000,
          "description": "Announcement body."
        },
        "categories": {
          "type": "array",
          "description": "Bounded list of Shayari categories."
        },
        "notifications": {
          "type": "array",
          "description": "Bounded list of live notifications."
        },
        "shayari_list": {
          "type": "array",
          "description": "Bounded list of Shayari items."
        },
        "heroHeadline": {
          "type": "string",
          "maxLength": 240,
          "description": "Public website hero headline."
        },
        "heroSubheadline": {
          "type": "string",
          "maxLength": 500,
          "description": "Public website hero subheadline."
        },
        "websiteControls": {
          "type": "object",
          "description": "Real-time visibility toggles controlled from Admin Notification Panel."
        },
        "suvichar_list": {
          "type": "array",
          "description": "Bounded list of inspirational Suvichar items."
        },
        "photo_shayari_list": {
          "type": "array",
          "description": "Bounded list of Photo Shayari overlay cards."
        },
        "default_language_code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10,
          "description": "Default app language ISO code synced from Admin Panel."
        },
        "default_country_code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10,
          "description": "Default country/region ISO code synced from Admin Panel."
        },
        "supported_languages": {
          "type": "array",
          "description": "Bounded list (max 40) of live languages and translated UI strings for Android User App."
        },
        "supported_countries": {
          "type": "array",
          "description": "Bounded list (max 60) of supported countries, dial codes, currencies, and default language mappings."
        },
        "dynamic_theme": {
          "type": "object",
          "description": "Real-time Android UI theme colors, dark mode, corner radius, and font scale controlled by admin."
        },
        "scheduled_notifications": {
          "type": "array",
          "description": "Bounded list (max 50) of language- and country-targeted scheduled push notifications."
        },
        "engagement_tools": {
          "type": "object",
          "description": "Daily streak, mood filters, 1-tap WhatsApp share, and interactive community poll settings."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "ownerId",
        "organizationName",
        "supportEmail",
        "app_name",
        "latest_version_code",
        "force_update_url",
        "maintenance_mode",
        "maintenance_message",
        "privacy_policy_url",
        "social_link",
        "ads_enabled",
        "announcement_title",
        "announcement_message",
        "categories",
        "notifications",
        "shayari_list",
        "heroHeadline",
        "heroSubheadline",
        "websiteControls",
        "suvichar_list",
        "photo_shayari_list",
        "updatedAt"
      ]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "Registered Android app user profile visible in Social & Live Chat Monitor.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique app user ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Public user display name."
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_.]+$",
          "description": "Unique user handle without @."
        },
        "city": {
          "type": "string",
          "maxLength": 80,
          "description": "User city or town."
        },
        "address": {
          "type": "string",
          "maxLength": 200,
          "description": "User location or full address detail."
        },
        "bio": {
          "type": "string",
          "maxLength": 300,
          "description": "Short shayari bio."
        },
        "isOnline": {
          "type": "boolean",
          "description": "Current real-time online presence indicator."
        },
        "isBlocked": {
          "type": "boolean",
          "description": "Whether admin has blocked this spam or abusive user."
        },
        "blockReason": {
          "type": "string",
          "maxLength": 240,
          "description": "Moderation reason when blocked."
        },
        "followersCount": {
          "type": "integer",
          "description": "Total followers count."
        },
        "followingCount": {
          "type": "integer",
          "description": "Total following count."
        },
        "likesReceivedCount": {
          "type": "integer",
          "description": "Total profile/shayari likes received."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "username",
        "city",
        "address",
        "bio",
        "isOnline",
        "isBlocked",
        "blockReason",
        "followersCount",
        "followingCount",
        "likesReceivedCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "SocialEdge": {
      "title": "SocialEdge",
      "description": "Follow or Like interaction connecting an actor user to a target user.",
      "type": "object",
      "properties": {
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who performed the follow or like."
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who received the follow or like."
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of actor."
        },
        "targetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of target."
        },
        "type": {
          "type": "string",
          "enum": ["follow", "like"],
          "description": "Social interaction type."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Interaction timestamp."
        }
      },
      "required": [
        "actorId",
        "targetId",
        "actorName",
        "targetName",
        "type",
        "createdAt"
      ]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "1-on-1 real-time user chat conversation metadata monitored by admin.",
      "type": "object",
      "properties": {
        "participantIds": {
          "type": "array",
          "description": "Exact 2-element list of participant app user IDs."
        },
        "participantNames": {
          "type": "array",
          "description": "Exact 2-element list of participant display names."
        },
        "lastMessage": {
          "type": "string",
          "maxLength": 1000,
          "description": "Most recent chat message preview."
        },
        "lastSenderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of sender of the last message."
        },
        "messageCount": {
          "type": "integer",
          "description": "Total messages exchanged in this room."
        },
        "flaggedSpam": {
          "type": "boolean",
          "description": "Whether room has been flagged for spam review."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last message timestamp."
        }
      },
      "required": [
        "participantIds",
        "participantNames",
        "lastMessage",
        "lastSenderId",
        "messageCount",
        "flaggedSpam",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual real-time message inside a 1-on-1 user chat room.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent chatRoom document ID."
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Sender user UID."
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Sender display name."
        },
        "receiverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Recipient user UID."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Message text content."
        },
        "isFlagged": {
          "type": "boolean",
          "description": "Moderation spam flag on individual message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Message creation server timestamp."
        }
      },
      "required": [
        "roomId",
        "senderId",
        "senderName",
        "receiverId",
        "text",
        "isFlagged",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminAllowlist" },
      "description": "Verified admin allowlist documents granting write access to Shayari Lok Admin Panel."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Private user profile document keyed by Firebase Auth UID."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/RepoConnection" },
      "description": "User's GitHub repository connection settings (without PAT)."
    },
    "/users/{userId}/drafts/{draftId}": {
      "schema": { "$ref": "#/entities/ConfigDraft" },
      "description": "User's cloud-persisted Shayari Lok config.json draft."
    },
    "/users/{userId}/publishLogs/{logId}": {
      "schema": { "$ref": "#/entities/PublishLog" },
      "description": "Immutable history of GitHub config.json publishes by the user."
    },
    "/users/{userId}/proxyProfiles/{profileId}": {
      "schema": { "$ref": "#/entities/ProxyProfile" },
      "description": "Non-secret GitHub API proxy and failover routing configuration for the signed-in admin."
    },
    "/publicSites/{siteId}": {
      "schema": { "$ref": "#/entities/PublicSite" },
      "description": "Publicly readable real-time Shayari Lok website state keyed by owner UID."
    },
    "/publicSites/{siteId}/appConfig/{configId}": {
      "schema": { "$ref": "#/entities/PublicSite" },
      "description": "Live ShayariLok User App remote control document (AdMob IDs, Logo, Theme, Dark Mode, Privacy Policy, Banners, and FAQs)."
    },
    "/publicSites/{siteId}/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/PublicSite" },
      "description": "Individual carousel banner documents with clickable external URLs."
    },
    "/publicSites/{siteId}/faqs/{faqId}": {
      "schema": { "$ref": "#/entities/PublicSite" },
      "description": "Individual FAQ items with questions, answers, and categories."
    },
    "/appUsers/{appUserId}": {
      "schema": { "$ref": "#/entities/AppUser" },
      "description": "Registered Android app user profiles, locations, follower/like counts, and block flags."
    },
    "/socialEdges/{edgeId}": {
      "schema": { "$ref": "#/entities/SocialEdge" },
      "description": "Real-time follow and like edges between Android app users."
    },
    "/chatRooms/{roomId}": {
      "schema": { "$ref": "#/entities/ChatRoom" },
      "description": "1-on-1 chat threads between Android app users."
    },
    "/chatRooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real-time messages inside a chat room monitored by admin."
    }
  }
}
